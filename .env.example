# ====================================================================
# Telegram Content Migration Bot - Environment Configuration
# ====================================================================

# 1. Telegram API Credentials (from https://my.telegram.org)
# Log in, click "API development tools", and copy your api_id & api_hash
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# 2. Telegram Bot Token (from @BotFather on Telegram)
# Create a new bot with /newbot command and copy the API token
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# 3. Your Personal Telegram User ID (from @userinfobot or @raw_data_bot)
# Only this Telegram account will be authorized to access the control UI
OWNER_ID=123456789

# 4. Optional: Your phone number (with country code, e.g., +1234567890)
# Used as a hint for the initial interactive terminal login
PHONE_NUMBER=

# ====================================================================
# Optional Advanced Settings
# ====================================================================
# Local temporary directory for download-then-upload pipeline
DOWNLOAD_DIR=./downloads

# File to store persistent execution logs
LOG_FILE=migration.log

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Number of messages between progress notification updates in the bot UI
PROGRESS_INTERVAL=25

# Delay range (in seconds) between individual message migrations
MIN_DELAY_SECONDS=1.0
MAX_DELAY_SECONDS=3.0

# Maximum FloodWait sleep threshold in seconds (jobs abort if wait exceeds this)
FLOOD_WAIT_MAX_SLEEP=300
